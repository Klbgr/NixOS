let
  # Create a custom version of the theme with your preferred config
  custom-sddm-theme = pkgs.where-is-my-sddm-theme.overrideAttrs (oldAttrs: {
    postInstall = ''
      # Copy the example config over the default theme.conf
      cp $out/share/sddm/themes/where_is_my_sddm_theme/example_configs/tree.conf \
         $out/share/sddm/themes/where_is_my_sddm_theme/theme.conf
      
      # If you need the background image as well (like for tree.conf)
      cp $out/share/sddm/themes/where_is_my_sddm_theme/example_configs/tree.png \
         $out/share/sddm/themes/where_is_my_sddm_theme/tree.png
    '';
  });
in